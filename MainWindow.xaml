<Window x:Class="app_tự_động.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="One Click Installer Pro"
        Width="1100"
        Height="760"
        MinWidth="940"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB"
        ResizeMode="CanResize">

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Bottom"
                Background="White"
                CornerRadius="12"
                Padding="12"
                Margin="16,0,16,16"
                BorderBrush="#D9E2F1"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStatus"
                           Text="Sẵn sàng"
                           Foreground="#2563EB"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="1"
                           x:Name="txtInternet"
                           Text="Internet: ?"
                           Foreground="#111827"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           x:Name="txtAdmin"
                           Text="Admin: ?"
                           Foreground="#111827"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="White"
                CornerRadius="14"
                Padding="16"
                Margin="16,0,16,12"
                BorderBrush="#D9E2F1"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0">
                    <Button x:Name="btnInstall"
                            Content="Tải và cài"
                            Width="150"
                            Height="44"
                            Margin="0,0,12,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnInstall_Click"/>

                    <Button x:Name="btnDownloadOnly"
                            Content="Chỉ tải về"
                            Width="140"
                            Height="44"
                            Margin="0,0,12,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Background="#0EA5E9"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnDownloadOnly_Click"/>

                    <Button x:Name="btnInstallFromFile"
                            Content="Cài từ file đã tải"
                            Width="170"
                            Height="44"
                            Margin="0,0,12,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Background="#10B981"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnInstallFromFile_Click"/>

                    <Button x:Name="btnCancel"
                            Content="Hủy"
                            Width="110"
                            Height="40"
                            Margin="8,0,0,0"
                            Background="#DC2626"
                            Foreground="White"
                            FontWeight="SemiBold"
                            IsEnabled="False"
                            Click="btnCancel_Click"/>
                </WrapPanel>

                <WrapPanel Grid.Row="2">
                    <Button x:Name="btnSelectAll"
                            Content="Chọn hết"
                            Width="110"
                            Height="40"
                            Margin="0,0,10,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="btnSelectAll_Click"/>

                    <Button x:Name="btnUnselectAll"
                            Content="Bỏ chọn hết"
                            Width="120"
                            Height="40"
                            Margin="0,0,10,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="btnUnselectAll_Click"/>

                    <Button x:Name="btnOpenFolder"
                            Content="Mở thư mục tải"
                            Width="145"
                            Height="40"
                            Margin="0,0,10,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="btnOpenFolder_Click"/>

                    <Button x:Name="btnOpenLogFile"
                            Content="Mở file log"
                            Width="125"
                            Height="40"
                            Margin="0,0,10,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="btnOpenLogFile_Click"/>

                    <Button x:Name="btnOpenChromeLink"
                            Content="Mở link Chrome"
                            Width="135"
                            Height="40"
                            Margin="0,0,10,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#F59E0B"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnOpenChromeLink_Click"/>

                    <Button x:Name="btnClear"
                            Content="Xóa log"
                            Width="100"
                            Height="40"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="btnClear_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16,16,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="22"
                        BorderBrush="#D9E2F1"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="One Click Installer Pro"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="14"
                                       Foreground="#6B7280"
                                       Text="Tool tải và cài phần mềm nhanh"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Border Background="#EEF4FF"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Đã chọn"
                                               Foreground="#6B7280"
                                               FontSize="12"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtSelectedCount"
                                               Text="0"
                                               Foreground="#2563EB"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#ECFDF5"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Thành công"
                                               Foreground="#6B7280"
                                               FontSize="12"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtSuccessCount"
                                               Text="0"
                                               Foreground="#10B981"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <Border Background="White"
                                CornerRadius="14"
                                Padding="20"
                                BorderBrush="#D9E2F1"
                                BorderThickness="1"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Danh sách phần mềm"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"/>

                                <Border Grid.Row="2"
                                        Background="#F8FAFC"
                                        CornerRadius="12"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Padding="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="420">
                                        <ItemsControl x:Name="itemsApps">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White"
                                                            CornerRadius="12"
                                                            Padding="14"
                                                            Margin="0,0,0,12"
                                                            BorderBrush="#E5E7EB"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Content="{Binding Name}"
                                                                          FontSize="15"
                                                                          FontWeight="SemiBold"
                                                                          Checked="AppCheckChanged"
                                                                          Unchecked="AppCheckChanged"/>

                                                                <TextBlock Text="{Binding Description}"
                                                                           Margin="24,6,0,0"
                                                                           Foreground="#6B7280"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"/>

                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Margin="24,8,0,0"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#2563EB"/>

                                                                <ProgressBar Value="{Binding Progress}"
                                                                             Margin="24,8,0,0"
                                                                             Height="10"
                                                                             Minimum="0"
                                                                             Maximum="100"/>

                                                                <TextBlock Text="{Binding Message}"
                                                                           Margin="24,6,0,0"
                                                                           Foreground="#6B7280"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="1"
                                                                    Content="✕"
                                                                    Width="26"
                                                                    Height="26"
                                                                    Margin="12,0,0,0"
                                                                    FontWeight="Bold"
                                                                    Background="#FEE2E2"
                                                                    Foreground="#DC2626"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand"
                                                                    Visibility="{Binding CanDeleteVisibility}"
                                                                    Click="DeleteApp_Click"
                                                                    ToolTip="Xóa phần mềm đã thêm"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="White"
                                CornerRadius="14"
                                Padding="20"
                                BorderBrush="#D9E2F1"
                                BorderThickness="1"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Thiết lập cài đặt"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12"
                                               Foreground="#111827"/>

                                    <CheckBox x:Name="chkSilentInstall"
                                              Content="Ưu tiên silent install"
                                              IsChecked="True"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>

                                    <CheckBox x:Name="chkSkipIfInstalled"
                                              Content="Bỏ qua nếu đã cài"
                                              IsChecked="True"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>

                                    <CheckBox x:Name="chkSkipIfExists"
                                              Content="Bỏ qua nếu file đã tải sẵn"
                                              IsChecked="True"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>

                                    <CheckBox x:Name="chkRetryDownload"
                                              Content="Tự retry nếu tải lỗi"
                                              IsChecked="True"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tùy chọn sau khi hoàn tất"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12"
                                               Foreground="#111827"/>

                                    <CheckBox x:Name="chkOpenFolderAfterDownload"
                                              Content="Mở thư mục sau khi tải xong"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>

                                    <CheckBox x:Name="chkOpenFolderAfterInstall"
                                              Content="Mở thư mục sau khi cài xong"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>

                                    <CheckBox x:Name="chkExportLog"
                                              Content="Tự lưu log ra file .txt"
                                              IsChecked="True"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="White"
                                CornerRadius="14"
                                Padding="20"
                                BorderBrush="#D9E2F1"
                                BorderThickness="1"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Thư mục tải"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="txtCustomFolder"
                                             Grid.Column="0"
                                             Height="38"
                                             FontSize="14"
                                             Padding="10,8"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Nhập hoặc dán đường dẫn thư mục tải"/>

                                    <Button x:Name="btnBrowseFolder"
                                            Grid.Column="2"
                                            Width="44"
                                            Height="38"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Background="#E5E7EB"
                                            Foreground="#111827"
                                            BorderThickness="0"
                                            ToolTip="Chọn thư mục bằng Explorer"
                                            Click="btnBrowseFolder_Click">
                                        <TextBlock Text="▼"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>

                                <WrapPanel Grid.Row="4">
                                    <Button x:Name="btnUseDefaultFolder"
                                            Content="Mặc định"
                                            Width="110"
                                            Height="38"
                                            Margin="0,0,10,0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Background="#E5E7EB"
                                            Foreground="#111827"
                                            BorderThickness="0"
                                            Click="btnUseDefaultFolder_Click"/>

                                    <Button x:Name="btnApplyFolder"
                                            Content="Áp dụng"
                                            Width="110"
                                            Height="38"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="btnApplyFolder_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Background="White"
                                CornerRadius="14"
                                Padding="20"
                                BorderBrush="#D9E2F1"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Thêm app từ link tải"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"/>
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               Text="Nhập link tải để thêm app mới vào danh sách mà không cần sửa code. App mới sẽ được lưu luôn vào apps.json."/>
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Tên app"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"/>
                                    <TextBox x:Name="txtCustomAppName"
                                             Grid.Row="2"
                                             Height="36"
                                             FontSize="14"
                                             Padding="10,8"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Ví dụ: AnyDesk"/>

                                    <TextBlock Grid.Row="4"
                                               Text="Link tải"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"/>
                                    <TextBox x:Name="txtCustomAppUrl"
                                             Grid.Row="6"
                                             Height="36"
                                             FontSize="14"
                                             Padding="10,8"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Dán link tải trực tiếp .exe / .msi / .zip"/>

                                    <TextBlock Grid.Row="8"
                                               Text="Tên file lưu (để trống sẽ tự tạo)"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"/>
                                    <TextBox x:Name="txtCustomAppFileName"
                                             Grid.Row="10"
                                             Height="36"
                                             FontSize="14"
                                             Padding="10,8"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Ví dụ: anydesk_installer.exe"/>

                                    <TextBlock Grid.Row="12"
                                               Text="Silent args (tùy chọn)"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"/>
                                    <TextBox x:Name="txtCustomAppSilentArgs"
                                             Grid.Row="14"
                                             Height="36"
                                             FontSize="14"
                                             Padding="10,8"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Ví dụ: /S hoặc /quiet"/>
                                </Grid>

                                <WrapPanel Grid.Row="4">
                                    <Button x:Name="btnAddCustomApp"
                                            Content="Thêm vào danh sách"
                                            Width="170"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="btnAddCustomApp_Click"/>

                                    <Button x:Name="btnClearCustomApp"
                                            Content="Xóa form"
                                            Width="110"
                                            Height="40"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Background="#E5E7EB"
                                            Foreground="#111827"
                                            BorderThickness="0"
                                            Click="btnClearCustomApp_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <Border Background="White"
                                CornerRadius="14"
                                Padding="16"
                                BorderBrush="#D9E2F1"
                                BorderThickness="1"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Thông tin nhanh"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"/>

                                <TextBlock x:Name="txtDownloadFolder"
                                           Margin="0,10,0,0"
                                           Text="Thư mục tải:"
                                           TextWrapping="Wrap"
                                           Foreground="#374151"/>

                                <TextBlock x:Name="txtLogFile"
                                           Margin="0,10,0,0"
                                           Text="Log file:"
                                           TextWrapping="Wrap"
                                           Foreground="#374151"/>

                                <TextBlock x:Name="txtCurrentTask"
                                           Margin="0,10,0,0"
                                           Text="Tác vụ hiện tại: Chưa có"
                                           TextWrapping="Wrap"
                                           Foreground="#374151"/>

                                <TextBlock x:Name="txtSummary"
                                           Margin="0,10,0,0"
                                           Text="Kết quả: Thành công 0 | Thất bại 0 | Bỏ qua 0"
                                           TextWrapping="Wrap"
                                           Foreground="#374151"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White"
                                CornerRadius="14"
                                Padding="16"
                                BorderBrush="#D9E2F1"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="300"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Tiến trình và nhật ký"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"/>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Tiến trình tổng"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               Margin="0,0,0,8"/>
                                    <ProgressBar x:Name="progressBar"
                                                 Height="18"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"/>
                                    <TextBlock x:Name="txtProgress"
                                               Text="0%"
                                               Margin="0,8,0,0"
                                               Foreground="#2563EB"
                                               FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4">
                                    <TextBlock Text="Tiến trình app hiện tại"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               Margin="0,0,0,8"/>
                                    <ProgressBar x:Name="progressCurrentApp"
                                                 Height="18"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"/>
                                    <TextBlock x:Name="txtCurrentAppProgress"
                                               Text="0%"
                                               Margin="0,8,0,0"
                                               Foreground="#0EA5E9"
                                               FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Grid.Row="6"
                                           Text="Nhật ký"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"/>

                                <TextBox x:Name="txtLog"
                                         Grid.Row="8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         Background="#0F172A"
                                         Foreground="#E5E7EB"
                                         BorderThickness="0"
                                         Padding="12"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>